# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Required by Paysera as the return and callback URL base.
APP_URL="https://your-domain.example"

# Paysera Checkout project credentials. Keep the sign password server-side.
PAYSERA_PROJECT_ID=""
PAYSERA_SIGN_PASSWORD=""
# Keep test mode enabled until your Paysera project is configured for live payments.
PAYSERA_TEST="1"
